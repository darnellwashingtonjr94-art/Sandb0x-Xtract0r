from abc import ABC, abstractmethod

class SandboxBase(ABC):
    """Abstract Base Class for all platform-specific sandbox runners."""

    @abstractmethod
    def revert_snapshot(self) -> bool:
        """Restores the virtual environment to a clean baseline snapshot."""
        pass

    @abstractmethod
    def execute_sample(self, sample_path: str, timeout: int = 180) -> dict:
        """Detonates sample and executes platform monitoring hooks."""
        pass

    @abstractmethod
    def cleanup((self) -> bool:
        """Terminates execution and wipes temporary VM state."""
        pass
